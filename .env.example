# Puerto en el que correrá el servidor web (Railway lo asigna automáticamente en producción)
PORT=3000

# Entorno de ejecución: development | production
NODE_ENV=production

# Número de WhatsApp oficial para contacto (506 = Costa Rica)
WHATSAPP_PHONE=50671489351

# Analítica propia (Railway Postgres entrega DATABASE_URL automáticamente)
# Definir una contraseña larga antes de habilitar el panel /admin/analytics.
ANALYTICS_ADMIN_USER=admin
ANALYTICS_ADMIN_PASSWORD=
# Token compartido entre Railway y una regla de encabezado de Cloudflare para confiar en provincia/region.
ANALYTICS_CF_TOKEN=
# Límite global de seguridad por instancia para eventos analíticos (por minuto).
ANALYTICS_EVENT_LIMIT_PER_MINUTE=300
# Railway suele requerir SSL. Para PostgreSQL local, usar PGSSLMODE=disable.
PGSSLMODE=
